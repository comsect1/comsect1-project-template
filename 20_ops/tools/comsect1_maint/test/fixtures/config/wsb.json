    "image_target": "windows-x86_64",
    "provider_family": {
      "kind": "hook"
    },
    "sdk_link_libraries": [],
    "provider_export_aliases": []
  },
  "cross_build": null,
  "native_gate": {
    "config": "20_ops/tools/native_gate_config.json"
  },
  "hooks": {
    "module": "20_ops/tools/product_hooks.py"
  }
